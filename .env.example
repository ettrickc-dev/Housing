# =====================================================================
# PlainRights Court — Environment variables
# Copy this file to `.env` and fill in real values for LOCAL development.
# In production, set these in Netlify (Site settings -> Environment variables).
#
# RULE OF THUMB:
#   VITE_* values are PUBLIC (shipped to the browser). Safe to commit? No —
#   but they are not secrets. Everything WITHOUT the VITE_ prefix is a SECRET
#   used only inside Netlify Functions and must never reach the client.
# =====================================================================

# ---- Supabase (frontend / public) ----
# Project Settings -> API -> Project URL  and  anon/public key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---- Supabase (server-side SECRET — Netlify Functions only) ----
# Project Settings -> API -> service_role key.  NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Stripe ----
# Publishable key is public (used by the browser checkout redirect).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret keys are SERVER-ONLY.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Resend (transactional email — SERVER ONLY) ----
RESEND_API_KEY=re_xxx
# Verified sender + admin recipient
RESEND_FROM_EMAIL=PlainRights Court <noreply@yourdomain.com>
ADMIN_EMAIL=ettrickc@gmail.com

# ---- App ----
# Used for absolute links in emails and Stripe redirect URLs.
APP_URL=http://localhost:8888
